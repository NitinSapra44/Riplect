# Riplek — environment variables (copy to .env and fill in)

# --- Supabase (database + auth + storage) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_DATABASE_URL=

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=

# --- Maps ---
GOOGLE_MAPS_API_KEY=

# --- AI Profile (Design Brief generator) ---
# Required for /studio "Generate" and section "Rework". Without it those
# endpoints return a clear 503 ("AI is not configured").
ANTHROPIC_API_KEY=
# Feature flags — the AI Profile ships dark. Enable both to use the studio +
# publish. (Server gate also auto-enables in any non-production env.)
ENABLE_AI_PROFILE=false        # server: gates publish + generate
VITE_ENABLE_AI_PROFILE=false   # client: gates the /studio editor
# Optional model overrides (defaults shown).
AI_PROFILE_GEN_MODEL=claude-opus-4-8
AI_PROFILE_EDIT_MODEL=claude-haiku-4-5-20251001
